{
  "name": "paiflow-hackathon-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start:all": "./start.sh",
    "dev": "next dev",
    "backend": ".venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:backend": ".venv/bin/python3 -m unittest backend.tests.test_api",
    "video:audio": "pnpm --dir video run audio",
    "video:capture": "pnpm --dir video run capture",
    "video:preview": "pnpm --dir video run preview",
    "video:render": "pnpm --dir video run render",
    "video:all": "pnpm --dir video run all"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-test-renderer": "19",
    "react-test-renderer": "19.3.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23 <9"
    }
  }
}
